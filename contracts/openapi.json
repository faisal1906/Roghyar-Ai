        "properties": {
          "error": {
            "$ref": "#/components/schemas/ReadinessError"
          }
        },
        "required": [
          "error"
        ],
        "title": "ErrorEnvelope",
        "type": "object"
      },
      "Health": {
        "properties": {
          "status": {
            "const": "ok",
