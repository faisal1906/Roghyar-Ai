            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "Health",
        "type": "object"
      },
      "ReadinessError": {
        "properties": {
          "code": {
            "const": "DEPENDENCY_UNAVAILABLE",
            "title": "Code",
            "type": "string"
          },
          "details": {
            "title": "Details",
            "type": "null"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "request_id": {
            "format": "uuid",
            "title": "Request Id",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message",
          "request_id"
        ],
        "title": "ReadinessError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "ROGHYAR AI",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
